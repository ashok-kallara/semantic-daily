# Daily news feed — runs at 12:00 UTC (8:00 AM Eastern)
# Env vars are loaded from /etc/environment (set by entrypoint.sh)
0 12 * * * root . /etc/environment; cd /app && su -s /bin/bash newsbot -c "PYTHONPATH=/app python -m src.main" >> /var/log/semantic-daily.log 2>&1

# Empty line required by cron
